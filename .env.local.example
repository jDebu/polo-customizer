# Copia este archivo a .env.local y llena los valores
# NUNCA commitear .env.local al repositorio

# Google Sheets Web App (crea en Apps Script > Implementar > App web)
VITE_SHEETS_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ImgBB — subida de comprobantes de pago (https://api.imgbb.com/)
VITE_IMGBB_KEY=your_imgbb_api_key

# Telegram Bot
VITE_TELEGRAM_TOKEN=1234567890:ABCdef_your_bot_token
VITE_TELEGRAM_CHAT_ID=-1001234567890

# Admin PIN (solo prototipo — usar auth real en producción)
VITE_ADMIN_PIN=1234

# Números de Yape y Plin mostrados al cliente
VITE_YAPE_NUMBER=987 654 321
VITE_PLIN_NUMBER=987 654 321
